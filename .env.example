# X API credentials — put real values only in Render Environment Variables
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# X username to read. Default: FabrizioRomano
X_USERNAME=FabrizioRomano

# Cache recent posts for this many milliseconds (default: 2 minutes)
X_CACHE_MS=120000

# Render provides PORT automatically
PORT=10000
